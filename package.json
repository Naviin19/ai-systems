    "demo:drift": "tsx demos/02-drift/run.ts",
    "demo:isolation": "tsx demos/05-isolation/run.ts",
    "demo:routeback": "tsx demos/03-routeback/run.ts",
    "demo:receipts": "tsx demos/04-receipts/run.ts",
    "demo:attest": "tsx demos/06-attest/run.ts",
    "diagrams": "python tools/diagram-compiler/build.py",
    "diagrams:verify": "python tools/diagram-compiler/verify.py",
