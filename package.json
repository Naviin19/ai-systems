{
  "name": "ai-systems",
  "version": "0.1.0",
  "private": true,
  "description": "The published architecture of a multi-agent AI factory and the runtime it ships to.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx demos/run-all.ts",
    "demo:contract": "tsx demos/01-contract/run.ts",
    "demo:drift": "tsx demos/02-drift/run.ts",
    "demo:isolation": "tsx demos/05-isolation/run.ts",
    "demo:routeback": "tsx demos/03-routeback/run.ts",
    "demo:receipts": "tsx demos/04-receipts/run.ts",
    "demo:attest": "tsx demos/06-attest/run.ts",
    "demo:powerbar": "tsx demos/07-powerbar/run.ts",
    "demo:silence": "tsx demos/08-silence/run.ts",
    "demo:abstain": "tsx demos/09-abstain/run.ts",
    "demo:reported-paths": "tsx demos/10-reported-paths/run.ts",
    "demo:write-surface": "tsx demos/11-write-surface/run.ts",
    "demo:emitter-instructions": "tsx demos/12-emitter-instructions/run.ts",
    "demo:anti-map": "tsx demos/13-anti-map/run.ts",
    "demo:receipt-v2": "tsx demos/14-receipt-v2/run.ts",
    "demo:trace-physics": "tsx demos/15-trace-physics/run.ts",
    "demo:assembled-prompt": "tsx demos/16-assembled-prompt/run.ts",
    "demo:enrich": "tsx demos/live/enrich/run.ts",
    "check:private": "node tools/check-private.mjs",
    "diagrams": "python tools/diagram-compiler/build.py",
    "diagrams:verify": "python tools/diagram-compiler/verify.py",
